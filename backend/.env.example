PORT=3000
NODE_ENV=production
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
VECTOR_DB_PATH=./vector/index.json
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
DB_PATH=./database
CORS_ORIGIN=https://lawlens.web.app,https://lawlens-f0ebc.web.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Firebase Auth — paste the entire service account JSON as a single line
# Get from: https://console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}

# Admin bootstrap (used by `npm run seed`). Get the UID from Firebase Console →
# Authentication → Users, or make the logged-in user an admin via the console.
ADMIN_FIREBASE_UID=your-firebase-uid
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Admin

# Optional: force the JSON file engine even when Firebase credentials exist
# DB_ENGINE=json

# Firebase Client Config (served to frontend via /api/config/firebase)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=1:your-app-id:web:your-app-hash
