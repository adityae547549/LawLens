PORT=3000
NODE_ENV=production
JWT_SECRET=your-secure-random-string-here-use-openssl-rand-base64-64
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
VECTOR_DB_PATH=./vector/index.json
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
DB_PATH=./database
CORS_ORIGIN=https://lawlens.web.app,https://lawlens-f0ebc.web.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
SELF_URL=https://your-app-name.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://lawlens.web.app/api/auth/google/callback

FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=1:your-app-id:web:your-app-hash
