rules_version = '2';

// LawLens Firebase Storage rules.
//
// Only the owner of a file may read or write their own uploads. The Node.js
// backend uses the Admin SDK (bypasses these rules) for server-side operations.
// Direct bucket access by signed URLs is scoped to the owner below.
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else: locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}